{
  "name": "@local/quick-reply",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "选中助手正文，一键引用回复（只填草稿）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupi00/dsh-quick-reply.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
