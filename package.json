{
  "name": "@local/quick-reply",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "选中任意一段文字一键引用回复；侧栏会话行也能引用该会话最后一条回答；出处带轮次或行号（都只填草稿）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupi00/dsh-quick-reply.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node test/helpers.test.mjs && node --check client.js && node --check index.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
